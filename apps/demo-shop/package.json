    "traffic": "tsx src/traffic.ts"
  },
  "dependencies": {
    "@ashamrai/flags-node": "workspace:*",
    "@ashamrai/flags-web": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.3"
  }
}
