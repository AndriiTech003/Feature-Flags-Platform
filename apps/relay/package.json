{
  "name": "@ffp/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@ashamrai/flags-contracts": "workspace:*",
    "@ashamrai/flags-evaluator": "workspace:*",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@ashamrai/flags-node": "workspace:*",
    "@ffp/api": "workspace:*",
    "@ffp/conformance": "workspace:*",
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.3"
  }
}
