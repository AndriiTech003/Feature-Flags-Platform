{
  "name": "@ffp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed.ts",
    "outbox": "node dist/outbox-main.js",
    "test:coverage": "vitest run -c vitest.coverage.config.ts"
  },
  "dependencies": {
    "@ashamrai/flags-contracts": "workspace:*",
    "@ashamrai/flags-evaluator": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.3"
  }
}
