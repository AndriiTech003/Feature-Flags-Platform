{
  "name": "@ashamrai/flags-cli",
  "version": "0.0.0",
  "description": "CLI for the feature flags platform: typed codegen for SDKs and find-stale for archived or unused flags",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "feature-flags",
    "cli",
    "codegen"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "vitest": "5.0.3"
  },
  "bin": {
    "flags": "./dist/bin.js"
  }
}
