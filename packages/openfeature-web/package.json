{
  "name": "@ashamrai/flags-openfeature-web",
  "version": "0.0.0",
  "description": "OpenFeature web provider backed by @ashamrai/flags-web (server-evaluated values, streaming updates)",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/openfeature-web"
  },
  "keywords": [
    "openfeature",
    "feature-flags",
    "provider"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.10.0"
  },
  "dependencies": {
    "@ashamrai/flags-web": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@openfeature/core": "^1.12.0",
    "@openfeature/web-sdk": "1.10.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "vitest": "5.0.3",
    "@ffp/relay": "workspace:*",
    "@ashamrai/flags-evaluator": "workspace:*"
  }
}
