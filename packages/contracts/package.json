{
  "name": "@ashamrai/flags-contracts",
  "version": "0.0.0",
  "description": "Zod schemas for the feature flags ruleset, semantic patch instructions, SDK events and management API",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ashamrai/flags-evaluator": "workspace:*",
    "@ffp/conformance": "workspace:*",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "vitest": "5.0.3"
  }
}
