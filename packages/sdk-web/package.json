{
  "name": "@ashamrai/flags-web",
  "version": "0.0.0",
  "description": "Browser feature flags SDK: server-evaluated values for one context, SSE updates, localStorage cache, bootstrap, under 5 KB gzip",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/sdk-web"
  },
  "keywords": [
    "feature-flags",
    "browser",
    "sdk",
    "sse",
    "experiments"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@ashamrai/flags-web (ESM, minified + gzip)",
      "path": "dist/index.js",
      "limit": "5 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ashamrai/flags-evaluator": "workspace:*",
    "@ffp/conformance": "workspace:*",
    "@ffp/relay": "workspace:*",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "vitest": "5.0.3"
  }
}
