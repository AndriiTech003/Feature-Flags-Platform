    {
      "name": "off returns off variation",
      "flagKey": "off-flag",
      "context": {
        "kind": "user",
        "key": "u1"
      },
      "default": true,
      "expect": {
        "value": false,
        "variationId": "off",
        "reason": {
          "kind": "OFF"
        }
      }
    },
    {
      "name": "off with null off variation returns default",
