{
  "name": "@ashamrai/flags-react",
  "version": "0.0.0",
  "description": "React bindings for @ashamrai/flags-web: FlagsProvider, useFlag and useFlagDetail on useSyncExternalStore",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/sdk-react"
  },
  "keywords": [
    "feature-flags",
    "react",
    "hooks",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@ashamrai/flags-react without react and flags-web",
      "path": "dist/index.js",
      "limit": "1.5 KB",
      "ignore": [
        "react",
        "@ashamrai/flags-web"
      ]
    }
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@ashamrai/flags-web": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^20.0.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "vitest": "5.0.3"
  }
}
