{
  "name": "@ashamrai/flags-node-redis",
  "version": "0.0.0",
  "description": "Redis PersistentStore for @ashamrai/flags-node: serve last known flags after a restart without the relay",
  "license": "MIT",
  "author": "Andrii Shamrai",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashamrai/feature-flags-platform.git",
    "directory": "packages/sdk-node-redis"
  },
  "keywords": [
    "feature-flags",
    "redis",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "test:integration": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ashamrai/flags-node": "workspace:*",
    "ioredis": "^5.11.1",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@ashamrai/flags-node": "workspace:^"
  }
}
