{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "CI",
    "VITEST_BROWSERS",
    "TESTCONTAINERS",
    "TEST_DATABASE_ADMIN_URL",
    "TEST_REDIS_URL",
    "DOCKER_HOST",
    "PLAYWRIGHT_BROWSERS_PATH",
    "BENCH_OUTPUT",
    "BENCH_STRICT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:browser": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "size": {
      "dependsOn": ["build"]
    },
    "publint": {
      "dependsOn": ["build"]
    },
    "attw": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
